<resources>

    <!-- Location on the screen of the center of the physical power button.
         Side-mounted power button on a 2460px tall panel. -->
    <dimen name="physical_power_button_center_screen_location_y">1056px</dimen>

    <!-- The fingerprint sensor sits inside the power button on the right edge. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_x">1080px</dimen>
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">1056px</dimen>

    <!-- Adjust the icon padding in status bar for rounded corners.
         Matches the 58px display corner radius reported by the HWC. -->
    <dimen name="rounded_corner_content_padding">58px</dimen>

    <!-- The padding on the top of the statusbar -->
    <dimen name="status_bar_padding_top">0px</dimen>

    <!-- The starting padding for the clock in the status bar. -->
    <dimen name="status_bar_clock_starting_padding">6px</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">30dp</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>

</resources>
