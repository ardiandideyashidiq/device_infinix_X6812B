<resources>
    <!-- Doze: does this device support STATE_DOZE? -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- If not zero, limits the internal screen recorder's framerate to the set value. -->
    <integer name="config_screenRecorderMaxFramerate">60</integer>

    <!-- If not empty, sets the AVC codec profile level used for the internal screen
         recorder. Possible values: 3, 3.1, 3.2, 4, 4.1, 4.2 -->
    <string name="config_screenRecorderAVCProfileLevel" translatable="false">4.1</string>

    <!-- Blur radius behind Notification Shade -->
    <dimen name="max_shade_window_blur_radius">17dp</dimen>
</resources>
