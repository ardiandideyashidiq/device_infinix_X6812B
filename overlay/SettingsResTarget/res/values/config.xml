<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- The number of vibration intensity levels supported by the device.
         Supported values are 1, 2, 3. -->
    <integer name="config_vibration_supported_intensity_levels">3</integer>

    <!-- Show battery cycle count -->
    <bool name="config_show_battery_cycle_count" translatable="false">false</bool>

    <!-- Display settings screen, Color mode options. Must be the same length and order
         as config_color_mode_options_values below. Only the values that also appear in
         framework-res config_availableColorModes are shown. -->
    <string-array name="config_color_mode_options_strings" translatable="false">
        <item>Natural</item>
        <item>Boosted</item>
    </string-array>

    <!-- Display settings screen, Color mode options. -->
    <integer-array name="config_color_mode_options_values">
        <item>0</item>
        <item>1</item>
    </integer-array>

</resources>
