# ST21NFC init script, imported from init.mt6768.rc.
#
# Stock also ships nfcstackp-vendor and STFlashTool here for FM/factory mode.
# They need system_ext ST components (libstnfc-nci) that this tree does not
# ship, so only the HAL service and its socket directory are set up.

on post-fs
    start nfc_hal_service

on post-fs-data
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
