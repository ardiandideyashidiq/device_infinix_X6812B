# ST21NFC HAL (android.hardware.nfc@1.2-service-st)
#
# The domain, exec label, st21nfc_device and vendor_nfc_socket_file types all
# come with device/mediatek/sepolicy_vndr (and hal_nfc_default from
# system/sepolicy); only the HAL-side access the MTK policy does not already
# grant is added here.

allow hal_nfc_default st21nfc_device:chr_file rw_file_perms;

allow hal_nfc_default vendor_nfc_socket_file:dir rw_dir_perms;
allow hal_nfc_default vendor_nfc_socket_file:file create_file_perms;
allow hal_nfc_default vendor_nfc_socket_file:sock_file create_file_perms;

# init/vendor_init create /data/vendor/nfc_socket in init.stnfc.rc
allow vendor_init vendor_nfc_socket_file:dir create_dir_perms;
allow vendor_init vendor_nfc_socket_file:file create_file_perms;
allow init vendor_nfc_socket_file:dir { getattr search };
